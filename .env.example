# ─── LLM Provider (pick one) ───────────────────────────────────────
# OpenAI
OPENAI_API_KEY=sk-...

# DeepSeek
DEEPSEEK_API_KEY=sk-...

# Ollama base URL (self-hosted, default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Which provider to use: "openai" | "deepseek" | "ollama"
EXPO_PUBLIC_LLM_PROVIDER=openai

# Model name for the selected provider
EXPO_PUBLIC_LLM_MODEL=gpt-4o-mini

# ─── Convex (optional – enables cross-device history sync) ──────────
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=

# ─── Development helpers ─────────────────────────────────────────────
# Set to "1" to use mock streaming responses (no API key needed)
EXPO_PUBLIC_MOCK_AI=0

# Wake word sensitivity: 0.0 (loose) – 1.0 (strict), default 0.5
EXPO_PUBLIC_WAKE_WORD_SENSITIVITY=0.5
